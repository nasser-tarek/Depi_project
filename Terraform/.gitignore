# Local .terraform directories (plugins)
**/.terraform/*

# .tfstate files (contain sensitive info about your infrastructure)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude sensitive .tfvars files containing passwords
*.tfvars
*.tfvars.json

# Ignore override files as they are usually local-only
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore plan files (binary output)
*.plan